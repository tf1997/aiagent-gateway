[Unit]
Description=AI Agent Gateway worker @SLOT@
PartOf=aiagent-gateway.service
BindsTo=aiagent-gateway-state.service
After=aiagent-gateway-state.service
[Service]
User=aiagent-gateway
Group=aiagent-gateway
EnvironmentFile=/etc/aiagent-gateway/gateway.env
ExecStart=@BINARY@ worker --slot=@SLOT@ --release=@RELEASE@ --listen=127.0.0.1:@DATA_PORT@ --admin=127.0.0.1:@ADMIN_PORT@
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
LimitNOFILE=65536
TimeoutStopSec=30

[Unit]
Description=AI Agent Gateway shared state
PartOf=aiagent-gateway.service
After=network-online.target
[Service]
User=aiagent-gateway
Group=aiagent-gateway
LoadCredential=gateway.yaml:/etc/aiagent-gateway/gateway.yaml
ExecStart=@BINARY@ state-server --config=%d/gateway.yaml
Restart=on-failure
RestartSec=2
RuntimeDirectory=aiagent-gateway
RuntimeDirectoryPreserve=yes
StateDirectory=aiagent-gateway
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aiagent-gateway /run/aiagent-gateway
TimeoutStopSec=35

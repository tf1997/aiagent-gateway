[Unit]
Description=Initialize AI Agent Gateway configuration
ConditionPathExists=!/var/lib/aiagent-gateway/config.json

[Service]
Type=oneshot
User=aiagent-gateway
Group=aiagent-gateway
LoadCredential=config.yaml:/etc/aiagent-gateway/config.yaml
WorkingDirectory=/var/lib/aiagent-gateway
StateDirectory=aiagent-gateway
StateDirectoryMode=0700
ExecStart=/usr/local/bin/aiagent-gateway --init-only --config=%d/config.yaml
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Unit]
Description=AI Agent Gateway
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=aiagent-gateway
Group=aiagent-gateway
LoadCredential=config.yaml:/etc/aiagent-gateway/config.yaml
LoadCredential=deployment.json:/etc/aiagent-gateway/deployment.json
ExecStart=@BINARY@ launch --config=%d/config.yaml --deployment=%d/deployment.json
Restart=on-failure
RestartSec=2
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=60
TimeoutStopSec=35
RuntimeDirectory=aiagent-gateway aiagent-gateway-control
RuntimeDirectoryMode=0700
StateDirectory=aiagent-gateway
StateDirectoryMode=0700
WorkingDirectory=/var/lib/aiagent-gateway
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aiagent-gateway /run/aiagent-gateway /run/aiagent-gateway-control
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

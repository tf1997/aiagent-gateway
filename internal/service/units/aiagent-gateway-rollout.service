[Unit]
Description=AI Agent Gateway release controller
PartOf=aiagent-gateway.service
After=aiagent-gateway-state.service aiagent-gateway-entry.service
[Service]
RuntimeDirectory=aiagent-gateway-control
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
LoadCredential=config.yaml:/etc/aiagent-gateway/config.yaml
ExecStart=@BINARY@ rollout-controller --config=%d/config.yaml
Restart=on-failure
RestartSec=2
UMask=0077
TimeoutStopSec=35
